<!DOCTYPE html>
<html>
<head>
    <title><%= pageTitle %></title>

    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
            background-color: #f4f4f4;
        }

        .box {
            width: 400px;
            margin: auto;
            padding: 25px;
            background: white;
            border-radius: 8px;
        }

        .error {
            color: darkred;
            font-weight: bold;
        }

        .success {
            color: darkgreen;
            font-weight: bold;
        }

        input {
            padding: 7px;
            margin-bottom: 12px;
        }

        button {
            padding: 8px 18px;
            cursor: pointer;
        }
    </style>
</head>

<body>

<div class="box">

    <h1><%= pageTitle %></h1>

    <% if (message) { %>
        <p class="error"><%= message %></p>
    <% } %>

    <% if (registeredUser) { %>

        <p class="success">
            Hello, <%= registeredUser %>! Your registration is complete.
        </p>

        <a href="/">Return to Registration</a>

    <% } else { %>

        <form action="/signup" method="POST">

            <label>Full Name:</label><br>
            <input type="text" name="name">
            <br>

            <label>Age:</label><br>
            <input type="number" name="age">
            <br>

            <button type="submit">Create Account</button>

        </form>

    <% } %>

</div>

</body>
</html>